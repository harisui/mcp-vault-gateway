# Local development only: copy to .dev.vars and run `npm run dev`.
# .dev.vars is git-ignored. Never commit real values.
# Deployed Workers get secrets with `wrangler secret put <NAME> --env personal|client` (see SETUP.md).

# Where the gateway is reachable. Must match the GitHub OAuth app callback URL.
PUBLIC_URL=http://localhost:8787

# 256-bit master key for AES-256-GCM (via HKDF). Exactly 32 random bytes, base64.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY_V1=
# Only during key rotation (see SETUP.md): ENCRYPTION_KEY_V2=... and ACTIVE_KEY_VERSION=2
# ENCRYPTION_KEY_V2=
ACTIVE_KEY_VERSION=1

# GitHub OAuth app used to sign in to the gateway. Create one per Worker:
# https://github.com/settings/developers -> OAuth Apps -> New OAuth App
# Callback URL: <PUBLIC_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# One 1Password Service Account token per vault ("group"). Name: OP_TOKEN_<GROUP>.
# The group name is the lowercased suffix: OP_TOKEN_PERSONAL -> "personal".
# Create at 1Password.com -> Developer -> Service Accounts, with access to ONE vault only.
OP_TOKEN_PERSONAL=

# Comma-separated emails that see policy and 1Password errors in list_servers.
ADMIN_EMAILS=
