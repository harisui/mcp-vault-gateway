{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One codebase, two Workers. Always deploy with --env personal or --env client.
  // The two environments share NOTHING at runtime: separate KV namespaces, Durable Objects,
  // secrets and encryption keys.
  "name": "mcp-vault-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // The 1Password SDK core is WASM that Node loads from disk at runtime, which Workers forbid.
  // scripts/build-op-shim.mjs rewrites it to import the .wasm as a pre-compiled module.
  "build": { "command": "node scripts/build-op-shim.mjs" },
  "alias": { "@1password/sdk-core": "./src/onepassword/vendor/core.mjs" },
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }],

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CounterDO", "ServerDO"] }],

  "env": {
    "personal": {
      "name": "mcp-personal-server",
      "vars": {
        "PUBLIC_URL": "https://mcp-personal-server.<your-subdomain>.workers.dev"
      },
      "durable_objects": {
        "bindings": [
          { "name": "COUNTER_DO", "class_name": "CounterDO" },
          { "name": "SERVER_DO", "class_name": "ServerDO" }
        ]
      },
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "<personal-oauth-kv-id>" },
        { "binding": "CACHE_KV", "id": "<personal-cache-kv-id>" }
      ]
    },
    "client": {
      "name": "mcp-client-server",
      "vars": {
        "PUBLIC_URL": "https://mcp-client-server.<your-subdomain>.workers.dev"
      },
      "durable_objects": {
        "bindings": [
          { "name": "COUNTER_DO", "class_name": "CounterDO" },
          { "name": "SERVER_DO", "class_name": "ServerDO" }
        ]
      },
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "<client-oauth-kv-id>" },
        { "binding": "CACHE_KV", "id": "<client-cache-kv-id>" }
      ]
    }
  }
}
